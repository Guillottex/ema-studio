# ============================================================
#  EMA Studio — variables de entorno
#  Copiá este archivo como .env y ajustá los valores.
# ============================================================

# Puerto público de la aplicación (http://localhost:8080)
APP_PORT=8080

# Base de datos PostgreSQL (contenedor "db")
POSTGRES_DB=ema_studio
POSTGRES_USER=ema
POSTGRES_PASSWORD=cambiar_esta_clave

# Seguridad: usá un valor largo y aleatorio (ej.: openssl rand -hex 32)
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES=12h

# Orígenes permitidos para CORS (separados por coma). "*" permite todos.
CORS_ORIGIN=http://localhost:8080

# Usuario administrador inicial (se crea sólo si no existe ningún usuario)
ADMIN_EMAIL=admin@ema.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador

# Cargar el curso de demostración "Excel Básico", plantillas y banco de preguntas
SEED_DEMO=true

# Límites de archivos (MB) y ancho máximo de imágenes optimizadas (px)
MAX_UPLOAD_MB=200
MAX_IMAGE_MB=20
IMAGE_MAX_WIDTH=2400

# IA (opcional): none | anthropic | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Para proveedores compatibles con OpenAI (ej. Azure, servidores locales)
AI_BASE_URL=

LOG_LEVEL=info

# Identidad visual: logo de EMA Servicios que se descarga al cargar los datos iniciales
# (vacío para no descargarlo; el frontend lo descarga al construir la imagen)
BRAND_LOGO_URL=https://www.emaservicios.com.ar/images/logo-color.png
